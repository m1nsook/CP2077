#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    DELAMAINAV_VERSION_MAJOR,DELAMAINAV_VERSION_MINOR,DELAMAINAV_VERSION_PATCH,DELAMAINAV_VERSION_BUILD
  PRODUCTVERSION DELAMAINAV_VERSION_MAJOR,DELAMAINAV_VERSION_MINOR,DELAMAINAV_VERSION_PATCH,DELAMAINAV_VERSION_BUILD
  FILEFLAGSMASK  0x3fL
#ifdef DELAMAINAV_DEV_BUILD
  FILEFLAGS      0x1L          /* VS_FF_PRERELEASE */
#else
  FILEFLAGS      0x0L
#endif
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_DLL
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "DelamainAV"
      VALUE "FileDescription",  "DelamainAV native plugin"
      VALUE "FileVersion",      DELAMAINAV_VERSION_STRING
      VALUE "InternalName",     "DelamainAV"
      VALUE "OriginalFilename", "DelamainAV.dll"
      VALUE "ProductName",      "DelamainAV"
      VALUE "ProductVersion",   DELAMAINAV_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 0x04b0
  END
END