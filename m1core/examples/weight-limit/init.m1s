-- Weight Limit Sample: a real m1core Lua mod, not a CET dependency.
-- The same source is compiled into init.m1c by Windows CI.
local MOD_ID = "m1core.weight_limit_sample"
local MOD_NAME = "Weight Limit (Sample)"
local SCHEMA = [[
[
  {"id":"enabled","kind":"boolean","label":"Custom weight limit","default":true,"group":"Carry Capacity",
   "description":"Turn off to restore the normal game carry capacity."},
  {"id":"limit","kind":"integer","label":"Carry capacity (kg)","default":500,
   "min":50,"max":5000,"step":10,"group":"Carry Capacity",
   "description":"Target total carry capacity. Applied as a temporary additive player stat modifier."}
]
]]

local registered = false
local elapsed = 0
local tracked = { modifier = nil, stats = nil, entity = nil, playerKey = nil, limit = nil }
local lastError = nil

local function forget()
    tracked.modifier = nil
    tracked.stats = nil
    tracked.entity = nil
    tracked.playerKey = nil
    tracked.limit = nil
end

local function removeOurModifier()
    if tracked.modifier ~= nil then
        -- Remove only OUR modifier; never wipe vanilla, item, or other mods.
        local ok, err = pcall(function()
            tracked.stats:RemoveModifier(tracked.entity, tracked.modifier)
        end)
        if not ok then
            print("[weight-limit] Cannot remove owned modifier: " .. tostring(err))
            return false
        end
    end
    forget()
    return true
end

local function apply()
    local player = Game.GetPlayer()
    if player == nil then
        -- A new save/load will establish a fresh game entity.
        forget()
        return
    end
    local stats = Game.GetStatsSystem()
    if stats == nil then return end
    local entity = player:GetEntityID()
    if entity == nil then return end
    local playerKey = tostring(entity)
    if tracked.playerKey ~= nil and tracked.playerKey ~= playerKey then
        -- Old game-session entity: the engine discards its modifiers.
        forget()
    end

    local enabled = m1core.getJson(MOD_ID, "enabled") == "true"
    local limit = tonumber(m1core.getJson(MOD_ID, "limit"))
    if limit == nil then return end

    if not enabled then
        removeOurModifier()
        return
    end
    if tracked.modifier ~= nil and tracked.limit == limit then return end
    if not removeOurModifier() then return end

    local current = stats:GetStatValue(entity, "CarryCapacity")
    local delta = limit - current
    if math.abs(delta) < 0.01 then return end

    local createModifier =
        Game["gameRPGManager::CreateStatModifier;gamedataStatTypegameStatModifierTypeFloat"]
    local modifier = createModifier("CarryCapacity", "Additive", delta)
    if modifier == nil then error("Could not create CarryCapacity stat modifier") end
    stats:AddModifier(entity, modifier)

    tracked.modifier = modifier
    tracked.stats = stats
    tracked.entity = entity
    tracked.playerKey = playerKey
    tracked.limit = limit
    print("[weight-limit] Set carry capacity to " .. tostring(limit) .. " kg")
end

local function safelyApply()
    if not registered then return end
    local ok, err = pcall(apply)
    if ok then
        lastError = nil
    elseif lastError ~= tostring(err) then
        lastError = tostring(err)
        print("[weight-limit] " .. lastError)
    end
end

registerForEvent("onInit", function()
    registered = m1core.registerJson(MOD_ID, MOD_NAME, SCHEMA)
    if not registered then
        print("[weight-limit] Unable to register m1core settings")
        return
    end
    safelyApply()
end)

registerForEvent("onUpdate", function(deltaTime)
    elapsed = elapsed + (deltaTime or 0)
    if elapsed < 0.5 then return end
    elapsed = 0
    safelyApply()
end)

registerForEvent("onShutdown", function()
    removeOurModifier()
end)
