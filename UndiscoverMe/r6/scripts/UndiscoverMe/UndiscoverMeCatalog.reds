module MisoRevealMapPins

// Generated from the original 212-row catalog and 175 journal IDs.
// Source TSV files live in tools/catalog; never package them as a Lua mod.
public class UDMCatalogRow {
  public let hash: Uint32;
  public let key: String;
  public let variant: gamedataMappinVariant;
  public let position: Vector4;
  public let ep1: Bool;
  public let questId: String;
  public let caption: String;
  public let owned: NewMappinID;
  public let completed: Bool;

  public static func Make(hash: Uint32, key: String, variant: gamedataMappinVariant, x: Float, y: Float, z: Float, ep1: Bool, questId: String, caption: String) -> ref<UDMCatalogRow> {
    let row = new UDMCatalogRow();
    row.hash = hash;
    row.key = key;
    row.variant = variant;
    row.position.X = x;
    row.position.Y = y;
    row.position.Z = z;
    row.position.W = 1.0;
    row.ep1 = ep1;
    row.questId = questId;
    row.caption = caption;
    return row;
  }

